{
  "name": "@local/dsh-web-access",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Lets the Web GUI's launch token, session lifetime, and phone address be configured live from a Settings page.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dependencies": {
    "qrcode": "^1.5.4",
    "@deepseek-ai/schemastery": "~3.19.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
